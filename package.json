{
  "name": "playwright-reference-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted, cross-linked Playwright interview/revision reference site (VitePress + GitHub Pages)",
  "scripts": {
    "split": "tsx scripts/split-source.ts",
    "test": "tsx --test tests/*.test.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "build": "npm run split && npm run docs:build",
    "preview": "vitepress preview docs",
    "link-check": "linkinator docs/.vitepress/dist --recurse --fragments --skip 'https://playwright\\.dev/.*' --skip 'https://trace\\.playwright\\.dev/.*'"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "linkinator": "^6.1.2",
    "markdown-it": "^14.3.0",
    "search-insights": "^2.17.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitepress": "^1.6.3"
  }
}
